* text=auto eol=lf

# Keep Windows command scripts in their native line ending.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets and archives.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.xz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
